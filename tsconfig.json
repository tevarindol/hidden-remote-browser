{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "extension",
    "outDir": "extension",
    "lib": ["esnext", "dom"],
    "types": ["chrome"]
  },
  "include": ["extension/**/*.ts"],
  "//exclude": "tsc otherwise auto-excludes outDir, which equals rootDir here",
  "exclude": []
}
