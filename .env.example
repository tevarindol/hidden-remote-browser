TELEGRAM_TOKEN=
TG_CHAT_ID=  # required: chat id the bot sends captures to
CHROME_URL=http://localhost:9222
SEND_PHOTO=false  # send a viewport screenshot as Task.png
HTML_SELECTOR=main  # CSS selector of the element captured in Task.html
KDE_DEVICE_ID=  # optional: Android device id (kdeconnect-cli -a --id-only); set to share capture as text to the phone
